{
  "_comment": "Paths use a placeholder token (written as SCRIPTS_DIR between doublecurly braces in the plugin source) which sync-agents.ps1 replaces with the consumer's absolute scripts dir at install time. The result is concrete absolute paths with no runtime variable expansion needed (no CLAUDE_PLUGIN_ROOT or REPO_ROOT that fail to expand in VS Code Copilot chat-subagent hook execution).",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "edit|write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/no-op-guard.js\" orchestrator"
          },
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/speckit-receipt-guard.js\""
          }
        ]
      },
      {
        "matcher": "edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/no-op-guard.js\" debugger"
          },
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/no-op-guard.js\" qa-analyst"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/no-op-guard.js\" session-end"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"{{SCRIPTS_DIR}}/no-op-guard.js\" subagent-stop"
          }
        ]
      }
    ]
  }
}
